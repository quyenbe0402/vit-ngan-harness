<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG OVERLAY ONLY.

  The Phase A loopback mock runs on the developer machine over plaintext
  ws://, so debug builds must be permitted cleartext. The main source set
  denies it; see app/src/main/res/xml/network_security_config.xml.

  This file is reachable only from app/src/debug/AndroidManifest.xml, so a
  release build never reads it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>