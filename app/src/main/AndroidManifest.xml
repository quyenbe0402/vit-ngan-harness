<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      M0-008A: Termux inter-app bridge.

      Termux 0.118.3 exposes exactly one service other apps may call,
      com.termux/.app.RunCommandService, guarded by this custom permission.
      Declaring it lets the Harness *ask* Termux to run something in Termux'
      own sandbox; the permission is `dangerous`, so the user still decides.

      This does NOT by itself grant any filesystem access. Termux' sandbox
      stays Termux'; the Harness gains a request channel, not a data channel.
      Workspace authorisation remains an Android-side concern.

      Verified against termux/termux-app @ v0.118.3
      (see docs/M0-008A_TERMUX_IPC_BOUNDARY_AUDIT.md).
    -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!--
      M21 Phase A: the app now holds real network reachability.

      INTERNET is required by the frozen pivot (docs/PIVOT-DECISION.md): the
      Hermes gateway runs on a remote host and the app is a thin wss:// client.
      There is no variant of the pivot that avoids this permission.

      It is declared unconditionally rather than in a debug manifest on
      purpose: a debug-only permission produces a release build that fails with
      a SocketTimeoutException in the field rather than at the desk.

      ACCESS_NETWORK_STATE is required in addition to INTERNET, because
      ConnectivityManager.registerDefaultNetworkCallback - which the reconnect
      supervisor uses to detect the network returning - throws
      SecurityException at runtime without it. Omitting it would not fail at
      build time.

      This supersedes finding F-01 in docs/PIVOT_EXECUTION_AUDIT.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".HarnessApplication"
        android:allowBackup="false"
        android:label="Vit Ngan Harness"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
          M0-005 adds the launcher activity. It performs no filesystem,
          network or device-administration work: it only renders UI and calls
          TaskViewModel.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Vit Ngan Harness">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>