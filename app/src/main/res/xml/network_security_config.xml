<?xml version="1.0" encoding="utf-8"?>
<!--
  M21 Phase A.

  MAIN source set: cleartext is DENIED at the platform level. The production
  client speaks wss:// only, and a misconfigured ws:// URL in a release build
  fails loudly here rather than silently sending traffic in the clear.

  The debug overlay at app/src/debug/res/xml/network_security_config.xml
  overrides this to permit cleartext, because the Phase A loopback mock runs on
  the developer machine over plaintext ws://.

  Deliberately NOT set: android:usesCleartextTraffic="true" on the application
  element, which would disable this protection everywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>