# Default: normalize to LF in the repository, native on checkout.
* text=auto eol=lf

# Windows-native scripts: checkout with CRLF so PowerShell behaves predictably.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Documentation
*.md    text eol=lf
*.txt   text eol=lf

# Android / JVM / Gradle sources
*.java  text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.gradle text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.properties text eol=lf

# JavaScript
*.js    text eol=lf
*.cjs   text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf

# Binary assets must never be line-ending translated
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.apk   binary
*.aab   binary
*.so    binary
*.jar   binary
*.zip   binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.mp3   binary
*.woff  binary
*.woff2 binary

# LFS is already installed on this machine (git-lfs); keep declared types consistent
*.psd   filter=lfs diff=lfs merge=lfs -text
*.fig   filter=lfs diff=lfs merge=lfs -text
